-- templates/provision_user.sql.j2
IF NOT EXISTS (SELECT 1 FROM sys.database_principals WHERE name = '{{ contained_user_name }}')
BEGIN
    CREATE USER [{{ contained_user_name }}] WITH PASSWORD = '{{ contained_user_password }}';
    ALTER ROLE db_datareader ADD MEMBER [{{ contained_user_name }}];
    SELECT 'CHANGED' AS Status;
END
ELSE
BEGIN
    SELECT 'NO_CHANGE' AS Status;
END