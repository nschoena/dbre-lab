-- Create the audit table if it doesn't exist
IF NOT EXISTS (SELECT * FROM sys.tables WHERE name = 'ansible_deployment_log')
BEGIN
    CREATE TABLE ansible_deployment_log (
        log_id INT IDENTITY(1,1) PRIMARY KEY,
        deployment_timestamp DATETIME DEFAULT GETDATE(),
        github_run_id VARCHAR(50),
        deployed_by VARCHAR(100),
        branch_name VARCHAR(100),
        git_commit_sha VARCHAR(100),
        status VARCHAR(20)
    );
END

-- Insert a robust record for this run
INSERT INTO ansible_deployment_log (github_run_id, deployed_by, branch_name, git_commit_sha, status)
VALUES ('{{ gh_run_id }}', '{{ gh_actor }}', '{{ gh_ref }}', '{{ gh_sha }}', 'SUCCESS');